{
  "scenarioName": "account-list",
  "requiredScenarioState": "Started",
  "request": {
    "method": "GET",
    "urlPath": "/api/account",
    "queryParameters": {
      "personId": {
        "matches": "[0-9]+"
      },
      "size": {
        "equalTo": "1"
      }
    },
    "headers": {
      "Authorization": {
        "matches": "Bearer \\S+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "content": [],
      "page": 0,
      "size": 1,
      "totalElements": 0,
      "totalPages": 0
    }
  }
}